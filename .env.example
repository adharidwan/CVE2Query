# Copy to .env. .env is gitignored and never committed.
# OpenCode Go (OpenAI-compatible endpoint):
CVE2CHECKER_LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
CVE2CHECKER_LLM_MODEL=deepseek-v4.1-flash
CVE2CHECKER_LLM_API_KEY=
CVE2CHECKER_LLM_TIMEOUT=600
CVE2CHECKER_LLM_MAX_TOKENS=32768

# Paste your OpenCode Go API key here (from https://opencode.ai/console):
OPENCODE_API_KEY=

# Optional GitHub token for PR/commit discovery.
GITHUB_TOKEN=

# Optional CodeQL executable override.
# CODEQL_PATH=D:\path\to\codeql.cmd
